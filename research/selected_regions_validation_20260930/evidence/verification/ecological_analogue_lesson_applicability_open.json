  "conclusions": {
    "LME_032": "No new correction indicated for Mugil/Chanos low-confidence omnivore analogues: accepted BenthicOmnivores has approximately52.15%detritus, unlike California animal-prey Benthicfish. Existing unlisted-source/transfer qualification retained.",
    "LME_026": "No new correction indicated by California finding: source34explicit mullets/Sparisoma and36Siganus provide local herbivore/detritivore representation; Mola is source-explicit14. Kyphosidae remains Low ecological extension, not source membership.",
    "EEZ_941_and_EEZ_598": "Existing Verylow16/17placements have a different source definition from California: explicitly includes herbivore families Acanthuridae/Kyphosidae/Scaridae as well as many other fish families. Epipelagic-stage/adultcoastal feeding mismatch remains material. Source inclusion of those families does not prove Mugil/Chanos membership. A bounded source-stage applicability follow-up is needed before final clearance.",
    "LME_036": "Current Mola30/31assessment uses operative large-pelagic size/habitat criterion; no diet-based exclusion follows automatically. Mugil/Chanos sourcefinal27ambiguity already Low. Need retain this distinction in final lesson applicability record."
  },
  "next_step": "No outstanding follow-up from this lesson. Regional conclusions remain local and parameter preservation remains mandatory.",
  "completed_region_dispositions": {
    "EEZ_941": {
      "decision": "Retain Mugilidae and Chanos chanos in Epi fish 16 / Epi small fish 17 at Very low membership and overall confidence. No numerical or scientific-input change.",
      "reason": "Table 1 PDF p9 was re-inspected visually. The mixed epipelagic fish group explicitly lists coastal/reef families including Acanthuridae, Kyphosidae and Scaridae; the list is non-exhaustive. This establishes a practical weak coastal/near-surface mixed-fish connection under M11, not actual membership of Mugilidae or Chanidae. The deeper forage pools and named predators do not offer a better habitat/taxonomic connection. Final group 17 is explicitly larval/juvenile; the biomass split is an assumed stage/catchability proxy, not evidence of landed stages. Feeding and adult-stage mismatches are already disclosed in both taxon rows. Source membership and model diet represent different evidence and neither is overwritten.",
      "limits": "No claim of representative adult detritivore/herbivore energy pathways, observed caught composition, or model approval. The source pooled diets contain no explicit algal/detrital share; uncertainty remains material despite small regional catch shares."
    },
    "EEZ_598": {
      "decision": "Retain Mugilidae in groups 16/17 at Very low; same exact accepted WCPO source/model, same source-specific justification and stage/feeding limitations as EEZ_941.",
      "regional_scope": "Only source group interpretation transfers. Local catch amounts, unresolved labels, geography and regional conclusions remain independent."
    },
    "LME_032": {
      "decision": "Retain Low benthic-omnivore analogues for Chanos/Mugil labels. Accepted group 17 has a substantial explicit detrital feeding component and a practical benthic-omnivore connection; not the same source guild as California."
    },
    "LME_026": {
      "decision": "Retain explicit source-listed Mugil cephalus / Mola members and supported source-guild extensions. Do not treat differences in aggregate group diets as permission to remove their source membership."
    },
    "LME_036": {
      "decision": "Retain operative source size/habitat assignments and existing Low ambiguous Chanos/Mugil mapping; no automatic California outcome transfer."
    },
