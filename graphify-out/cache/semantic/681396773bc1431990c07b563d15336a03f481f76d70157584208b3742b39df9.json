{"nodes": [{"id": "seaaroundusextraction_readme_project", "label": "All Sea Around Us EEZs \u2014 TE = 0.1 Release", "file_type": "document", "source_file": "SeaAroundUsExtraction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "seaaroundusextraction_readme_group_jensen_aggregation", "label": "Group-Level Jensen-Affected PPR Aggregation (SeaAroundUs)", "file_type": "rationale", "source_file": "SeaAroundUsExtraction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial/functional group SPPR exponentiates the group's catch-weighted mean trophic level once, rather than summing each taxon's own exponentiated SPPR. Because SPPR = 10^(TL-1) is convex, this is a direct, deliberate application of Jensen's inequality: group PPR can only ever be \u2264 the sum of its member taxa's PPR, never more. The gap is kept on purpose \u2014 it measures the cost of moving from taxa to groups, which an Ecopath model cannot show on its own because it has no taxon level. In this 2019 EEZ release the understatement is 22.27% for commercial groups and 14.44% for functional groups; the top-level repository README reports a related but distinct 'globally' measured figure of 22.93%/16.48%."}, {"id": "seaaroundusextraction_readme_convexity_bound_check", "label": "group_ppr_within_convexity_bound Validation Check", "file_type": "concept", "source_file": "SeaAroundUsExtraction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "seaaroundusextraction_readme_spatial_flags", "label": "Spatial Overlap Flags (low_lme_overlap, prefer_eez_candidate, review_110_120)", "file_type": "concept", "source_file": "SeaAroundUsExtraction/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "seaaroundusextraction_read