{"nodes": [{"id": "pprestimation_readme_project", "label": "PPREstimation Project", "file_type": "document", "source_file": "PPREstimation/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pprestimation_readme_known_test_failures", "label": "Known Test Failures (1 failed, 76 passed, 18 errors)", "file_type": "rationale", "source_file": "PPREstimation/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "18 errors are FileNotFoundErrors because their fixture model real_models/new_EwE_jsons/62_10062_Black_Sea_(1960-1969).json lived in a directory the owner deliberately removed; the affected assertions depend on that specific model's scientific properties, so the tests were deliberately not repointed at a substitute fixture \u2014 that is a call about the algorithm's own test data, not one to make while moving files around. The 1 failure asserts exactly 19 registered SPPR methods while the registry now holds 20; pre-existing and unrelated to any integration work."}, {"id": "pprestimation_readme_batch_export", "label": "create_PPRS_excel.py Batch Workbook Export (19 Method Configurations)", "file_type": "concept", "source_file": "PPREstimation/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pprestimation_readme_per_method_timeout", "label": "Per-Method Wall-Clock Timeout (180s default)", "file_type": "rationale", "source_file": "PPREstimation/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heavy methods (SPPR_EwE path enumeration, Monte-Carlo drivers) can run for hours and cannot be interrupted once inside numpy/sympy, so each method runs in a worker process with a wall-clock budget; an overrun is killed, recorded as a timeout (not a failure) in run_notes' status column, and the export moves on to the next method. One shared worker keeps the cost to a single process spawn per directory rather than per model."}, {"id": "pprestimation_readme_setup", "label": "Setup and Dependencies (numpy, pandas, scipy, sympy, igraph, tqdm, openpyxl)", "file_type": "document", "source_file": "PPREstimation/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "pprestimation_readme_project", "target": "pprestimation_pprcalculator_class", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_project", "target": "pprestimation_modeldata_class", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_project", "target": "pprestimation_utils_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_project", "target": "pprestimation_create_pprs_excel_main", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_project", "target": "pprestimation_readme_batch_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_batch_export", "target": "pprestimation_readme_per_method_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PPREstimation/README.md", "source_location": null, "weight": 1.0}, {"source": "pprestimation_readme_proje