  "missing_inputs": [
    "Full balanced numerical prey-by-predator diet matrix for final 2013 48-group model, including all zeros and import handling",
    "Native EwE model/database or equivalent complete export",
    "Ordered final functional-group list, units, catches, BA, immigration/emigration and detritus routing sufficient to confirm the exported variant"
  ],
  "findings": [
    {
      "route": "Publisher and article PDF",
      "outcome": "No linked supplement/native model identified on inspected legacy volume-155 page; modern journal archive starts at 2018. Original 33-page article has no embedded files. Figure 1 is a grayscale raster trophic-flow drawing; Figure 8 is mixed trophic impact, not diet.",
      "status": "target_not_found"
    },
    {
      "route": "EcoBase catalogue and public metadata XML",
      "outcome": "Catalogue Okhotsk entry is Chaikina_1980_OkhotskSea, not Radchenko. 389 public metadata XML records checked; Radchenko references concern Bering Sea. No matching final 48-group deposit identified.",
      "status": "target_not_found"
    },
    {
      "route": "Archived Ecopath catalogues",
      "outcome": "Five September-2015 catalogue captures contain 127 model links. No Okhotsk/Radchenko matching title; Pacific Basin collection /model/114 and Bering Sea /model/67 are different sources. Filtered public CDX URLs checked; named native model not identified.",
      "status": "target_not_found"
    },
    {
      "route": "Public repositories and bibliographic APIs",
      "outcome": "Corrected Figshare searches Okhotsk Ecopath, Okhotsk Radchenko and exact English/Russian title returned zero. DataCite returned two unrelated Oweniidae records. Crossref/OpenAlex results did not identify an exact focal record or verified DOI. GitHub repository search returned zero; Internet Archive metadata search returned zero.",
      "status": "target_not_found"
    },
    {
      "route": "ESSAS and institute archives",
      "outcome": "2008 programme scheduled Radchenko but detailed report says he could not attend. Presenter-file archive and later catalogue plans are historical leads, not evidence of a 48-group deposit. Relevant surviving named ESSAS/SakhNIRO/TINRO archive URLs did not identify the focal matrix.",
      "status": "target_not_found"
    },
    {
      "route": "NPAFC public dataset catalogue",
      "outcome": "Ecopath and Okhotsk searches displayed no dataset headings; Radchenko yielded the unrelated International Year of the Salmon expedition collection.",
      "status": "target_not_found"
    },
    {
      "route": "Explicit predecessor",
      "outcome": "Downloaded cited Radchenko 2011 proceedings (353 PDF pages). Article pp.70-81 concerns 36 groups. No full numerical diet matrix identified there. Cannot transplant into final 48-group state.",
      "status": "downloaded_but_target_incomplete"
    },
    {
      "route": "Related coauthored paper",
      "outcome": "Zavolokin, Radchenko and Naydenko 2016, DOI 10.23849/npafcb6/259.278, 20 pages. Appendix Tables 2/4 (printed pp.272/274) are western Bering 1986/2006; Tables 6/8 (pp.276/278) are Pacific waters off Kuril Islands 1991/2009. Complete matrices exist, but these are 19/20-group epipelagic models, not focal 48-group Okhotsk.",
      "status": "downloaded_verified_different_models"
    },
    {
      "route": "Full institutional dissertation",
      "outcome": "Downloaded Gorbatenko 2018, 468 pages, 58 numbered appendices. Chapter 4 includes feeding data; Appendices 56/57, p.467, quantify prey consumption for six dominant nekton groups in 2000/2009. Chapter 8 and p.324 distinguish and criticize aspects of Radchenko 2015 calculations. Independent data cannot substitute for balanced final diets. No embedded attachments or focal numerical diet matrix found.",
      "status": "downloaded_verified_independent_evidence"
    },
    {
      "route": "PICES inventory",
      "outcome": "Report 55, Table 2.1 printed p.12/PDF p.25, confirms 48-group Radchenko 2015 Okhotsk model. Supplementary-material attribution also refers to Christensen et al. 2014; not evidence of a Radchenko supplement.",
      "status": "downloaded_verified_inventory"
    },
    {
      "route": "False report-title search lead",
      "outcome": "PICES Report41 is actually Fraser River sockeye advisory report (170 pages), not trophic model report. Search snippet mixed publication-list references. Correct trophic report is Report25 (2003), preceding 2011-13 focal construction; no focal dataset recovered.",
      "status": "downloaded_rejected_identity"
    }
  ],
  "limitations": [
    "Not found after these public searches does not establish that no supplement or privately held export exists.",
    "Zenodo direct API was HTTP 403; no exhaustive direct Zenodo search is claimed. Indexed search and DataCite checks were complementary routes.",
    "Figshare broad Okhotsk result was limited to first 100 records. AND queries returned unrelated global results and are excluded from absence evidence; corrected plain-term searches were retained.",
    "Initial all-subdomains Wayback pattern returned unrelated URLs; corrected regex-filtered CDX queries and actual catalogue page reads were used instead.",
    "GitHub repository search does not exhaust code-file contents; archive filename filters do not search every archived file body.",
    "Web reader failures were separately recorded; legitimate public HTTP retrieval successfully recovered Gorbatenko dissertation and modern VNIRO pages.",
    "No attacks, access-control bypass, credential use, purchases or author contact were performed.",
    "Current selected model, validation DOCX and map were not edited during this recovery search."
  ],
