{"kind":"table","sheet":"Taxonomy","address":"A1:C40","rows":40,"cols":3,"values":[["seq","group_name","taxon_descr"],[1,"Diatoms","Diatoms; species not enumerated."],[2,"Dino/silicoflagellates","Dinoflagellates and silicoflagellates; species not enumerated."],[3,"Microzooplankton","Microzooplankton, 20–200 µm; source inherited size class."],[4,"Mesozooplankton","Mesozooplankton, 200–2000 µm; source inherited size class."],[5,"Macrozooplankton","Macrozooplankton, 2–20 mm; source inherited size class."],[6,"Gelatinous zooplankton","Small gelatinous zooplankton; taxa not enumerated; excludes the separately added Chrysaora plocamia group."],[7,"Chrysaora plocamia","Chrysaora plocamia medusae, large scyphozoan jellyfish; top 7.5 m layer used for biomass integration."],[8,"Macrobenthos","Macrobenthos; species composition not documented in the focal or inspected predecessor methods."],[9,"Sardine","Sardinops sagax."],[10,"Anchovy ","Engraulis ringens."],[11,"Mesopelagic fish","Mesopelagic fishes: Vinciguerria lucetia, Lampanyctus spp., Leuroglossus spp.; source spellings retained."],[12,"Jumbo squid","Dosidicus gigas."],[13,"Other cephalopods","Other cephalopods: Loligo gahi, Octopus vulgaris, Logigunculla sp.; historical source spellings retained."],[14,"Other small pelagic fish","Other small pelagic fishes; Anchoa nasus is an explicit example. Scomberesox saurus, Exocoetidae and Sufflogobius bibarbatus in predecessor Table1 are parameter analogues, not established local members."],[15,"Horse mackerel","Trachurus murphyi."],[16,"Chub mackerel","Scomber japonicus, source historical name."],[17,"Other large pelagic fish","Other large pelagic fishes; explicit examples Sarda chiliensis, Coryphaena hippurus and Thunnus albacares."],[18,"Small hake ","Merluccius gayi peruanus, small hake <29 cm. Source does not specify length convention and leaves the printed boundary gap unresolved."],[19,"Medium hake","Merluccius gayi peruanus, medium hake 30–49 cm. Source does not specify length convention."],[20,"Large hake ","Merluccius gayi peruanus, large hake >50 cm. Source does not specify length convention and leaves the printed boundary gap unresolved."],[21,"Flatfish","Flatfishes: Paralichthys adspersus, Hippoglosina sp.; source spelling retained."],[22,"Small demersal fish","Small demersal fishes; examples Odonthestes regia, Labrisomus philippi, Ctenosciaena peruviana; source spellings retained. No numerical size limit documented."],[23,"Benthic elasmobranchs","Benthic elasmobranchs; source does not enumerate species."],[24,"Butter fishes","Butter fishes: Trachinotus paitensis, Stromateus stellatus, Peprilus medius."],[25,"Conger","Congers; species not enumerated."],[26,"Medium demersal fish","Medium demersal fishes; explicit examples Paralabrax humeralis, Hemanthias peruanus, Mugil cephalus. No numerical size limit documented."],[27,"Medium sciaenids","Medium sciaenids; species and numerical size bounds not documented in inspected methods."],[28,"Sea robin","Prionotus stephanophrys."],[29,"Catfish","Galeichtys peruvianus; historical source spelling retained."],[30,"Chondrichthyans","Chondrichthyans; species not enumerated. Benthic elasmobranchs are modeled separately."],[31,"Seabirds","Phalacrocorax bougainvillii, Sula variegata, Pelecanus thagus; historical source names."],[32,"Pinnipeds","Otaria flavescens, Arctocephalus australis; source names."],[33,"Cetaceans","Cetaceans; species not enumerated in inspected source methods."],[34,"Green sea turtle","Chelonia mydas; green turtles. Source biomass calculation used mean curved carapace length 58.7 cm."],[35,"Leatherback turtle","Dermochelys coriacea; leatherback turtles. Source biomass calculation used mean curved carapace length 139.6 cm."],[36,"Anchovy eggs","Engraulis ringens eggs. Listed among living groups in prose but nonfeeding pool in source tables; receives 25% of anchovy production-fate flow in TableC."],[37,"Fishery offal","Fishery offal; detrital pool receiving fishery discard fate."],[38,"Pelagic detritus","Pelagic detritus; detrital pool."],[39,"Benthic detritus","Benthic detritus; detrital pool, residual export1 in TableC."]]}
