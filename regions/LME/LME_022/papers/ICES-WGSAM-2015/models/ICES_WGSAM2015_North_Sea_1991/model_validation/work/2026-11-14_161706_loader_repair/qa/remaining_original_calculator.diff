+    def _refresh_missing_biomass_accum(self, groups_df: pd.DataFrame, enabled: bool,
+                                     zero_biomass_accum: bool) -> pd.DataFrame:
+        """Complete only source-missing living BA from the finalized pre-floor flows.
+
+        This opt-in computational closure never repairs known BA, changes biology,
+        or treats an unsolved consumer's runtime q fallback as observed zero.
+        """
+        if not isinstance(enabled, (bool, np.bool_)):
+            raise ValueError('refresh_missing_biomass_accum must be Boolean')
+        if not enabled:
+            return groups_df
+        df = groups_df.copy()
+        source = getattr(getattr(self, '_model', None), 'groups_data', None)
+        if source is None:
+            source = getattr(self, '_source_groups_before_completion', pd.DataFrame())
+        source_ba = source.get('biomass_accum', pd.Series(dtype=float))
+        diet = self._DC.reindex(index=df.index, columns=df.index)
+        final_flows = diet.mul(df['q'], axis='index').mask(diet.eq(0), 0.)
+        final_flows.loc[~df.trophic_info.eq('Regular'), :] = 0.
+        final_predation = final_flows.sum(axis=0, skipna=False)
+        entries = []
+        for seq, row in df.iterrows():
+            before = row['biomass_accum']
+            migration = row['net_migration'] - row.get('detritus_import', 0.)
+            terms = [row['p'], row['M0'], row['catch'], migration]
+            reason = 'applied'
+            if row['trophic_info'] not in ('Regular', 'PP'):
+                reason = 'excluded_trophic_type'
+            elif seq not in source_ba.index:
+                reason = 'source_ba_identity_unavailable'
+            elif pd.notna(source_ba.loc[seq]):
+                reason = 'source_ba_known'
+            elif zero_biomass_accum:
+                reason = 'zero_ba_default_preserved'
+            elif not np.isfinite(final_predation.loc[seq]):
+                reason = 'incomplete_final_predation'
+            elif not np.isfinite(terms).all():
+                reason = 'incomplete_production_terms'
+            elif not np.isclose(row['predation'], final_predation.loc[seq], rtol=1e-12, atol=1e-12):
+                reason = 'final_predation_inconsistent_with_diet'
+            else:
+                df.loc[seq, 'biomass_accum'] = (row['p'] - row['M0'] - row['catch']
+                                             - row['predation'] - migration)
+            after = df.loc[seq, 'biomass_accum']
+            entries.append(dict(group_seq=seq, group_name=row['group_name'],
+                source_biomass_accum=source_ba.get(seq, np.nan),
+                original_runtime_biomass_accum=before, runtime_biomass_accum=after,
+                final_predation=final_predation.loc[seq], reason=reason,
+                applied=reason == 'applied', biomass_accum_adjustment=after-before,
+                interpretation='Loader-derived closure; not observed biomass accumulation'))
+        self.missing_biomass_accum_ledger = pd.DataFrame(entries).set_index('group_seq')
+        return df
+
